# GhostBuster — Environment Variables
# Copy this file to .env and fill in your values

# Required for live Claude test generation
# Get yours at: https://console.anthropic.com/
# Leave empty to run in --demo mode (no API calls)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: HuggingFace token for authenticated Laya model downloads
# Needed if you hit rate limits on unauthenticated downloads
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# IBM watsonx.ai — live Granite remediation suggestions in SlopWatch
# Get yours at: https://cloud.ibm.com (Manage > Access (IAM) > API Keys,
# then create a watsonx.ai project and copy its Project ID)
# Leave empty to use built-in rule templates (demo/offline mode still works)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Optional overrides (defaults shown):
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
