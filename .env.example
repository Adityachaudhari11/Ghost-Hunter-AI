# Copy to .env and fill locally. Never commit .env.
# See README.md "Credentials Policy".

# GitHub (least-privilege PAT, only for PR read / comment in demo)
GITHUB_TOKEN=ghp_REPLACE_ME
GITHUB_WEBHOOK_SECRET=REPLACE_ME

# LLM (used only by Blueprint/Reuse/Evidence explanation; deterministic agents run without it)
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://REPLACE_ME
LLM_MODEL=REPLACE_ME

# IBM Bob 2.0 (orchestration). If unset, local asyncio fallback is used.
BOB_API_KEY=REPLACE_ME
BOB_BASE_URL=https://REPLACE_ME

# App
REPORT_DIR=./reports
DEMO_TARGET_REPO=./demo/demo-target-repo
API_HOST=127.0.0.1
API_PORT=8000

# Database (Postgres for scalable arch; local demo uses in-memory + JSON files)
DATABASE_URL=postgresql+psycopg://ghost:ghost@localhost:5432/ghosthunter
